# Local .terraform directories
**/.terraform/*

# .tfstate files (state is kept in S3 remote backend)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files that may contain secrets — do NOT commit
*.tfvars
*.tfvars.json
!example.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration / plan output
.terraformrc
terraform.rc
*.tfplan
.terraform.lock.hcl
