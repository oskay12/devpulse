{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false
  },
  "DatabaseSettings": {
    "ConnectionString": "Host=devpulse-rds.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com;Port=5432;Database=devpulse;Username=devpulse_user;Password=__SET_VIA_ENV_OR_SECRET__",
    "MaxRetryAttempts": 3,
    "CommandTimeoutSeconds": 30
  },
  "OpenSearch": {
    "Endpoint": "https://search-devpulse-xxxxxxxxxxxx.us-east-1.es.amazonaws.com",
    "AuthMode": "BasicAuth",
    "Username": "__SET_VIA_ENV_OR_SECRET__",
    "Password": "__SET_VIA_ENV_OR_SECRET__",
    "RequestTimeoutSeconds": 30,
    "CommitsIndex": "devpulse-commits",
    "PullRequestsIndex": "devpulse-pull-requests",
    "ReviewsIndex": "devpulse-reviews"
  },
  "RabbitMq": {
    "HostName": "devpulse-rabbitmq",
    "Port": 5672,
    "Username": "__SET_VIA_ENV_OR_SECRET__",
    "Password": "__SET_VIA_ENV_OR_SECRET__",
    "VirtualHost": "/",
    "Queues": {
      "WebhookEvents": "devpulse.webhook.events",
      "MetricsCalculation": "devpulse.metrics.calculate",
      "SearchIndexing": "devpulse.search.index",
      "ImageOptimization": "devpulse.media.optimize"
    }
  }
}
